  <script>
    const q=s=>document.querySelector(s);
    const state = { motion:'same', mode:'explore', running:false, start:0, practice:null, pendingPracticeIntent:false, practiceDifficulty:'all', practiceQueue:[], practiceQueueKey:null, practiceLastId:null };

    function toggleAcc(btn){ btn.classList.toggle('open'); btn.nextElementSibling.classList.toggle('show'); }

    /* ---------- shared physics ---------- */
    function calcFrom(u,a,h,g,motion){
      let rad=a*Math.PI/180, ux=u*Math.cos(rad), uy=motion==='horizontal'?0:u*Math.sin(rad), t,range,maxH;
      if(motion==='same'){ t=2*uy/g; range=ux*t; maxH=uy*uy/(2*g); }
      else { t=(uy+Math.sqrt(uy*uy+2*g*h))/g; range=ux*t; maxH=h+uy*uy/(2*g); }
      let peakT=uy/g;
      let out={u,a,h,g,rad,ux,uy,t,range,maxH,peakT};
