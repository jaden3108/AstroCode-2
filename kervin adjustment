      return out;
    }
    function vals(){return {u:Math.max(0,+q('#speed').value||0), a:+q('#angle').value||0, h:Math.max(0,+q('#height').value||0), g:+q('#planet').value};}
    function calculate(){ let v=vals(); return calcFrom(v.u,v.a,v.h,v.g,state.motion); }
    function currentData(){ return (state.mode==='practice' && state.practice) ? calcFrom(state.practice.scenario.u,state.practice.scenario.a,state.practice.scenario.h,state.practice.scenario.g,state.motion) : calculate(); }

    /* ---------- explore mode ---------- */
    function explain(result){let d=calculate(), detail=q('#resultDetail'), title='', body='';
      if(result==='ux'){title='Initial horizontal velocity';body=`The launch velocity is resolved horizontally using <code>uₓ = u cos θ</code>.<br><code>uₓ = ${d.u} cos ${d.a}° = ${d.ux.toFixed(2)} m s⁻¹</code>`;}
      if(result==='uy'){title='Initial vertical velocity';body=`The launch velocity is resolved vertically using <code>uᵧ = u sin θ</code>.<br><code>uᵧ = ${d.u} sin ${d.a}° = ${d.uy.toFixed(2)} m s⁻¹</code>`;}
      if(result==='peak'){title='Time to maximum height';body=`At maximum height, the vertical velocity is zero. Use <code>v = uᵧ − gt</code>.<br><code>0 = ${d.uy.toFixed(2)} − ${d.g}t</code><br><code>t = uᵧ/g = ${d.uy.toFixed(2)}/${d.g} = ${(d.uy/d.g).toFixed(2)} s</code>`;}
      if(result==='time'){title='Time of flight';body=state.motion==='same'?`The projectile returns to its launch height, so its upward and downward travel times are equal.<br><code>t = 2uᵧ/g = 2(${d.uy.toFixed(2)})/${d.g} = ${d.t.toFixed(2)} s</code>`:state.motion==='horizontal'?`The initial vertical velocity is zero, so use vertical displacement.<br><code>h = ½gt²</code><br><code>t = √(2h/g) = √(2 × ${d.h}/${d.g}) = ${d.t.toFixed(2)} s</code>`:`Use vertical displacement from launch point to ground.<br><code>0 = h + uᵧt − ½gt²</code><br><code>0 = ${d.h} + ${d.uy.toFixed(2)}t − ½(${d.g})t²</code><br>Solving gives <code>t = ${d.t.toFixed(2)} s</code>.`;}
      if(result==='range'){title='Horizontal range';body=`Horizontal velocity stays constant because air resistance is ignored.<br><code>R = uₓt</code><br><code>R = ${d.ux.toFixed(2)} × ${d.t.toFixed(2)} = ${d.range.toFixed(1)} m</code>`;}
      if(result==='height'){title='Maximum height';body=state.motion==='horizontal'?`A horizontal launch has no initial upward velocity, so its greatest height is its starting height.<br><code>maximum height = ${d.h.toFixed(1)} m</code>`:state.motion==='same'?`At the highest point, vertical velocity is zero. Use <code>v² = uᵧ² − 2gH</code>.<br><code>H = uᵧ²/(2g) = ${d.uy.toFixed(2)}²/(2 × ${d.g}) = ${d.maxH.toFixed(1)} m</code>`:`First find height gained above the launch point: <code>uᵧ²/(2g)</code>.<br><code>height = h + uᵧ²/(2g)</code><br><code>${d.h} + ${d.uy.toFixed(2)}²/(2 × ${d.g}) = ${d.maxH.toFixed(1)} m</code>`;}
      let wasOpen=detail.classList.contains('show')&&detail.dataset.result===result;detail.dataset.result=result;detail.innerHTML=`<h3>How was this calculated?</h3>${body}`;detail.classList.toggle('show',!wasOpen);}
    function output(){let d=calculate(), planet=q('#planet').selectedOptions[0].text; q('#timeOut').innerHTML=`${d.t.toFixed(2)} <sup>s</sup>`;q('#rangeOut').innerHTML=`${d.range.toFixed(1)} <sup>m</sup>`;q('#heightOut').innerHTML=`${d.maxH.toFixed(1)} <sup>m</sup>`;q('#uxOut').innerHTML=`${d.ux.toFixed(2)} <sup>m s⁻¹</sup>`;q('#uyOut').innerHTML=`${d.uy.toFixed(2)} <sup>m s⁻¹</sup>`;q('#peakTimeOut').innerHTML=`${(d.uy/d.g).toFixed(2)} <sup>s</sup>`;document.querySelectorAll('.case-one-result').forEach(card=>card.hidden=state.motion!=='same');q('#resultDetail').classList.remove('show');q('#simTitle').textContent=`${state.motion==='horizontal'?'Horizontal': 'Angled'} launch on ${planet}`;q('#simSub').textContent=state.motion==='horizontal'?'The launch velocity is entirely horizontal.':'The horizontal and vertical motions act independently.';
      let work=state.motion==='same'?`<b>1. Resolve the launch velocity</b><br><code>uᵧ = u sin θ = ${d.u} sin ${d.a}° = ${d.uy.toFixed(2)} m s⁻¹</code><br><b>2. Find the time of flight</b><br><code>t = 2uᵧ / g = ${d.t.toFixed(2)} s</code><br><b>3. Find the range</b><br><code>R = uₓt = ${d.range.toFixed(1)} m</code>`: state.motion==='horizontal'?`<b>1. Vertical motion determines the time</b><br><code>h = ½gt² → t = √(2h/g) = ${d.t.toFixed(2)} s</code><br><b>2. Horizontal motion is constant speed</b><br><code>R = ut = ${d.u} × ${d.t.toFixed(2)} = ${d.range.toFixed(1)} m</code>`:`<b>1. Resolve vertical velocity</b><br><code>uᵧ = u sin θ = ${d.uy.toFixed(2)} m s⁻¹</code><br><b>2. Use vertical displacement</b><br><code>0 = h + uᵧt − ½gt²</code><br><code>t = ${d.t.toFixed(2)} s; R = uₓt = ${d.range.toFixed(1)} m</code>`;q('#formula').innerHTML=work; draw(0);}

    /* ---------- shared canvas ---------- */
    function draw(progress){const c=q('#scene'), ctx=c.getContext('2d'), r=c.getBoundingClientRect(), ratio=devicePixelRatio||1;c.width=r.width*ratio;c.height=r.height*ratio;ctx.scale(ratio,ratio);let W=r.width,H=r.height,d=currentData(), pad=40, maxX=Math.max(d.range,1), maxY=Math.max(d.maxH,1), sx=(W-pad*2)/maxX, sy=(H-55)/maxY, ground=H-31;
      ctx.clearRect(0,0,W,H);for(let i=0;i<46;i++){let x=(i*89)%W,y=(i*47)%210+6;ctx.fillStyle='#ddd0f7';ctx.globalAlpha=.55;ctx.fillRect(x,y,1.5,1.5)}ctx.globalAlpha=1;
      ctx.strokeStyle='#c4b5fd';ctx.lineWidth=2;ctx.setLineDash([5,6]);ctx.beginPath();for(let i=0;i<=100;i++){let t=d.t*i/100,x=d.ux*t,y=(d.h+d.uy*t-.5*d.g*t*t);let px=pad+x*sx,py=ground-y*sy;i?ctx.lineTo(px,py):ctx.moveTo(px,py)}ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='#5a4a78';ctx.fillRect(0,ground,W,4);ctx.fillStyle='#4a4160';ctx.font='12px Inter';ctx.fillText('ground level',W-98,ground+19);
      let t=d.t*Math.min(progress,1), x=pad+d.ux*t*sx,y=ground-(d.h+d.uy*t-.5*d.g*t*t)*sy;ctx.beginPath();ctx.arc(x,y,10,0,Math.PI*2);ctx.fillStyle='#ffffff';ctx.shadowColor='#b794f6';ctx.shadowBlur=18;ctx.fill();ctx.shadowBlur=0;ctx.strokeStyle='#8b5cf6';ctx.lineWidth=2;ctx.stroke();ctx.fillStyle='#fff';ctx.font='700 12px Inter';ctx.fillText('projectile',Math.min(x+15,W-75),Math.max(y-13,25));
      ctx.strokeStyle='#c4b5fd';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(pad,ground-4);ctx.lineTo(pad,ground-40);ctx.stroke();ctx.fillStyle='#ece3fb';ctx.font='12px Inter';ctx.fillText('g',pad+7,ground-30);
    }
    function animate(ts){if(!state.start)state.start=ts;let p=Math.min((ts-state.start)/2600,1);draw(p);if(p<1&&state.running)requestAnimationFrame(animate);else state.running=false;}
    function playAnimation(){state.running=true;state.start=0;requestAnimationFrame(animate);}

    /* ---------- practice mode: curated question bank ---------- */
    const PART_META = {
      t:{label:'Time of flight', unit:'s', type:'time'},
      range:{label:'Horizontal range', unit:'m', type:'dist'},
      maxH:{label:'Maximum height', unit:'m', type:'dist'},
      ux:{label:'Initial horizontal velocity', unit:'m s⁻¹', type:'vel'},
      uy:{label:'Initial vertical velocity', unit:'m s⁻¹', type:'vel'},
      peakT:{label:'Time to maximum height', unit:'s', type:'time'},
      impactSpeed:{label:'Speed at impact', unit:'m s⁻¹', type:'vel'},
      impactAngle:{label:'Angle below horizontal at impact', unit:'°', type:'angle'}
    };
    const CASE_PARTS = { same:['t','range','maxH','ux','uy','peakT'], height:['t','range','maxH'], horizontal:['t','range','impactSpeed','impactAngle'] };
    const CASE_TITLES = { same:'Angled launch — same level (Earth)', height:'Angled launch from a height (Earth)', horizontal:'Horizontal launch from a height (Earth)' };
    const QUESTION_BANK = {
      same:[
        {id:'same-e1', difficulty:'easy', text:"A cricketer throws a ball at 18 m s\u207B\u00B9 at 30\u00B0 above the horizontal, from ground level.", u:18,a:30,h:0},
        {id:'same-m1', difficulty:'medium', text:"A footballer free-kicks a ball at 22 m s\u207B\u00B9 at 50\u00B0 above the horizontal.", u:22,a:50,h:0},
        {id:'same-m2', difficulty:'medium', text:"A trick-shot basketball is launched at 14 m s\u207B\u00B9 at 65\u00B0 above the horizontal.", u:14,a:65,h:0},
        {id:'same-h1', difficulty:'hard', text:"A long-jumper leaves the take-off board at 9.5 m s\u207B\u00B9 at 22\u00B0 above the horizontal.", u:9.5,a:22,h:0}
      ],
      height:[
        {id:'height-e1', difficulty:'easy', text:"A cannon on a 20 m sea wall fires a shell at 30 m s\u207B\u00B9 at 35\u00B0 above the horizontal.", u:30,a:35,h:20},
        {id:'height-m1', difficulty:'medium', text:"A rescue flare is launched from a 40 m cliff at 25 m s\u207B\u00B9 at 50\u00B0 above the horizontal.", u:25,a:50,h:40},
        {id:'height-m2', difficulty:'medium', text:"A cannon on a 15 m fort wall fires at 18 m s\u207B\u00B9 at 60\u00B0 above the horizontal, into the moat below.", u:18,a:60,h:15},
        {id:'height-h1', difficulty:'hard', text:"A catapult on a 60 m castle wall launches a rock at 35 m s\u207B\u00B9 at 28\u00B0 above the horizontal.", u:35,a:28,h:60}
      ],
      horizontal:[
        {id:'horiz-e1', difficulty:'easy', text:"A ball rolls off a 5 m table at 3 m s\u207B\u00B9.", u:3,a:0,h:5},
        {id:'horiz-m1', difficulty:'medium', text:"A delivery drone flying at a steady 25 m releases a package horizontally at 12 m s\u207B\u00B9.", u:12,a:0,h:25},
        {id:'horiz-m2', difficulty:'medium', text:"A stunt motorcyclist launches horizontally off a 30 m ramp platform at 28 m s\u207B\u00B9.", u:28,a:0,h:30},
        {id:'horiz-h1', difficulty:'hard', text:"A car is accidentally driven off a 55 m cliff at 20 m s\u207B\u00B9 and lands in the sea below.", u:20,a:0,h:55}
      ]
    };

    function poolFor(motion,diff){ let list=QUESTION_BANK[motion]; if(diff && diff!=='all') list=list.filter(x=>x.difficulty===diff); return list; }
    function refillQueue(diff){ let pool=poolFor(state.motion,diff).map(x=>x.id); for(let i=pool.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];} state.practiceQueue=pool; }
    function nextQuestionId(){
      let key=state.motion+'|'+state.practiceDifficulty;
      if(state.practiceQueueKey!==key || !state.practiceQueue.length){ state.practiceQueueKey=key; refillQueue(state.practiceDifficulty); }
      let id=state.practiceQueue.shift();
      if(id===state.practiceLastId && state.practiceQueue.length){ state.practiceQueue.push(id); id=state.practiceQueue.shift(); }
      state.practiceLastId=id; return id;
    }
    function tolFor(type,val){ if(type==='angle') return 2; if(type==='time') return Math.max(0.1,0.05*Math.abs(val)); return Math.max(0.3,0.05*Math.abs(val)); }

    function workingFor(motion,key,s,d){
      const g=s.g;
      if(key==='ux') return `Resolve horizontally: <code>u\u2093 = u cos \u03B8 = ${s.u} \u00D7 cos ${s.a}\u00B0 = ${d.ux.toFixed(2)} m s\u207B\u00B9</code>`;
      if(key==='uy') return `Resolve vertically: <code>u\u1D67 = u sin \u03B8 = ${s.u} \u00D7 sin ${s.a}\u00B0 = ${d.uy.toFixed(2)} m s\u207B\u00B9</code>`;
      if(key==='peakT') return `At maximum height v = 0: <code>t = u\u1D67/g = ${d.uy.toFixed(2)}/${g} = ${d.peakT.toFixed(2)} s</code>`;
      if(key==='t'){
        if(motion==='same') return `Launch and landing are at the same height, so <code>t = 2u\u1D67/g = 2 \u00D7 ${d.uy.toFixed(2)}/${g} = ${d.t.toFixed(2)} s</code>`;
        if(motion==='horizontal') return `It falls from rest vertically: <code>h = \u00BDgt\u00B2 \u2192 t = \u221A(2h/g) = \u221A(2 \u00D7 ${s.h}/${g}) = ${d.t.toFixed(2)} s</code>`;
        return `Using <code>0 = h + u\u1D67t \u2212 \u00BDgt\u00B2</code> with h = ${s.h} m and u\u1D67 = ${d.uy.toFixed(2)} m s\u207B\u00B9 gives <code>t = ${d.t.toFixed(2)} s</code>`;
      }
      if(key==='range') return `Horizontal speed is constant: <code>R = u\u2093 \u00D7 t = ${d.ux.toFixed(2)} \u00D7 ${d.t.toFixed(2)} = ${d.range.toFixed(1)} m</code>`;
      if(key==='maxH'){
        if(motion==='same') return `At the top, v = 0: <code>H = u\u1D67\u00B2/(2g) = ${d.uy.toFixed(2)}\u00B2/(2 \u00D7 ${g}) = ${d.maxH.toFixed(1)} m</code>`;
        return `Height gained above the launch point is <code>u\u1D67\u00B2/(2g)</code>, added to the launch height: <code>${s.h} + ${d.uy.toFixed(2)}\u00B2/(2 \u00D7 ${g}) = ${d.maxH.toFixed(1)} m</code>`;
      }
      if(key==='impactSpeed') return `Vertical speed gained while falling: <code>v_y = gt = ${g} \u00D7 ${d.t.toFixed(2)} = ${d.vyImpact.toFixed(2)} m s\u207B\u00B9</code>. The horizontal speed hasn't changed, so combine with Pythagoras: <code>v = \u221A(u\u2093\u00B2 + v_y\u00B2) = ${d.impactSpeed.toFixed(2)} m s\u207B\u00B9</code>`;
      if(key==='impactAngle') return `The angle below the horizontal is <code>\u03B8 = tan\u207B\u00B9(v_y/u\u2093) = tan\u207B\u00B9(${d.vyImpact.toFixed(2)}/${d.ux.toFixed(2)}) = ${d.impactAngle.toFixed(1)}\u00B0</code>`;
      return '';
    }

    function renderGivenChips(s){
      let html=`<span class="given-chip">u = ${s.u} m s\u207B\u00B9</span>`;
      if(state.motion!=='horizontal') html+=`<span class="given-chip">\u03B8 = ${s.a}\u00B0</span>`;
      if(state.motion!=='same') html+=`<span class="given-chip">h = ${s.h} m</span>`;
      html+=`<span class="given-chip">g = 9.8 m s\u207B\u00B2 (Earth)</span>`;
      q('#givenChips').innerHTML=html;
    }
    function renderAnswerGrid(){
      let grid=q('#answerGrid'); grid.innerHTML='';
      state.practice.parts.forEach(p=>{
        let row=document.createElement('div'); row.className='answer-row'; row.dataset.key=p.key;
        row.innerHTML=`<div class="answer-label">${p.label}</div><div class="answer-input"><input type="number" step="0.01" placeholder="?"><span>${p.unit}</span></div><div class="answer-status"></div>`;
        grid.appendChild(row);
      });
      grid.querySelectorAll('input').forEach(inp=>inp.addEventListener('keydown',e=>{ if(e.key==='Enter'){ e.preventDefault(); if(!q('#checkBtn').disabled && !q('#checkBtn').hidden) q('#checkBtn').click(); } }));
    }
    function newProblem(){
      let qid=nextQuestionId();
      let question=QUESTION_BANK[state.motion].find(x=>x.id===qid);
      let scenario={u:question.u,a:question.a,h:question.h,g:9.8};
      let d=calcFrom(question.u,question.a,question.h,9.8,state.motion);
      let parts=CASE_PARTS[state.motion].map(key=>({key,label:PART_META[key].label,unit:PART_META[key].unit,type:PART_META[key].type,correct:d[key],locked:false}));
      state.practice={scenario,parts,attemptsLeft:3,d,question};
      let diffLabel=question.difficulty.charAt(0).toUpperCase()+question.difficulty.slice(1);
      q('#scenarioText').innerHTML=`<span class="diff-pill diff-${question.difficulty}">${diffLabel}</span>${question.text}`;
      renderGivenChips(scenario);
      renderAnswerGrid();
      q('#attemptsLabel').textContent='3 attempts left';
      q('#practiceFeedback').textContent='';
      q('#checkBtn').disabled=false; q('#checkBtn').hidden=false; q('#checkBtn').textContent='Check my answers';
      q('#nextQuestionBtn').hidden=true;
      q('#simTitle').textContent=CASE_TITLES[state.motion];
      q('#simSub').textContent='Watch the flight, then work out the numbers yourself.';
      draw(0); playAnimation();
    }
    function toggleReveal(row){ let rev=row.querySelector('.answer-reveal'); if(rev) rev.classList.toggle('show'); }
    function finishPractice(){ q('#checkBtn').hidden=true; q('#nextQuestionBtn').hidden=false; state.practice.parts.forEach(p=>{ let row=q(`.answer-row[data-key="${p.key}"]`); row.querySelector('input').disabled=true; }); }
    function revealRemaining(){
      state.practice.parts.forEach(p=>{
        if(p.locked) return;
        let row=q(`.answer-row[data-key="${p.key}"]`);
        row.classList.remove('incorrect'); row.classList.add('revealed');
        let val=p.type==='angle'?p.correct.toFixed(1):p.correct.toFixed(2);
        let reveal=document.createElement('div'); reveal.className='answer-reveal show';
        reveal.innerHTML=`<b>Answer: ${val} ${p.unit}</b><br>${workingFor(state.motion,p.key,state.practice.scenario,state.practice.d)}`;
        row.appendChild(reveal);
        let status=row.querySelector('.answer-status'); status.textContent='ℹ️'; status.onclick=()=>toggleReveal(row);
      });
    }
    function checkAnswers(){
      let allCorrect=true;
      state.practice.parts.forEach(p=>{
        if(p.locked) return;
        let row=q(`.answer-row[data-key="${p.key}"]`);
        let input=row.querySelector('input');
        let val=parseFloat(input.value);
        let tol=tolFor(p.type,p.correct);
        if(!isNaN(val) && Math.abs(val-p.correct)<=tol){
          p.locked=true; row.classList.add('correct'); row.classList.remove('incorrect'); input.disabled=true;
          let status=row.querySelector('.answer-status'); status.textContent='✓';
          let reveal=document.createElement('div'); reveal.className='answer-reveal'; reveal.innerHTML=`<b>Nice — that's right.</b><br>${workingFor(state.motion,p.key,state.practice.scenario,state.practice.d)}`;
          row.appendChild(reveal); status.style.cursor='pointer'; status.onclick=()=>toggleReveal(row);
        } else {
          allCorrect=false; row.classList.add('incorrect');
          row.querySelector('.answer-status').textContent='✗';
        }
      });
      if(allCorrect){
        q('#practiceFeedback').textContent='All correct — nice work! 🎉';
        finishPractice();
      } else {
        state.practice.attemptsLeft--;
        if(state.practice.attemptsLeft<=0){
          revealRemaining();
          q('#practiceFeedback').textContent="Here are the full worked solutions for the ones you didn't get.";
          finishPractice();
        } else {
          q('#attemptsLabel').textContent=`${state.practice.attemptsLeft} attempt${state.practice.attemptsLeft>1?'s':''} left`;
          q('#practiceFeedback').textContent='Some answers need another look — keep trying!';
        }
      }
    }

    /* ---------- mode + case switching ---------- */
    function setMode(m){
      state.mode=m;
      document.querySelectorAll('#modeToggle button').forEach(b=>b.classList.toggle('active',b.dataset.mode===m));
      q('#exploreControls').hidden = m!=='explore';
      q('#practiceControls').hidden = m!=='practice';
      q('#exploreResults').hidden = m!=='explore';
      q('#practiceResults').hidden = m!=='practice';
      q('#modeNote').textContent = m==='explore' ? 'Adjust the values yourself and see every result instantly.' : "Values are given by the question — work out the results and check them below.";
      q('#simNote').style.display = m==='explore' ? '' : 'none';
      if(m==='explore'){ output(); } else { newProblem(); }
    }
    function showChooser(){ q('#home').hidden=true; q('#lab').hidden=true; q('#chooseScreen').hidden=false; window.scrollTo({top:0,behavior:'smooth'}); }
    function chooseCase(choice){
      state.motion=choice;
      let names={same:'Angled launch — same ground level',height:'Angled launch from a height',horizontal:'Horizontal launch from a height'};
      q('#selectedCase').textContent=names[state.motion];
      q('#caseDiagram').innerHTML=document.querySelector(`.case-card[data-case="${state.motion}"] .diagram`).outerHTML;
      q('#angleBox').style.display=state.motion==='horizontal'?'none':'';
      q('#angleLabel').style.display=state.motion==='horizontal'?'none':'';
      let showH=state.motion!=='same';
      q('#heightBox').style.display=showH?'':'none';
      q('#heightLabel').style.display=showH?'':'none';
      q('#height').value=showH?(q('#height').value||10):0;
      q('#prompt').textContent=state.motion==='horizontal'?'What determines the time of flight: horizontal speed or initial height?':'At maximum height, what happens to the vertical component of velocity? Does the horizontal component change?';
      q('#home').hidden=true; q('#chooseScreen').hidden=true; q('#lab').hidden=false;
      if(state.pendingPracticeIntent){ state.pendingPracticeIntent=false; setMode('practice'); }
      else if(state.mode==='practice'){ newProblem(); }
      else { output(); }
      window.scrollTo({top:0,behavior:'smooth'});
    }

    /* ---------- wiring ---------- */
    q('#run').onclick=()=>{ output(); playAnimation(); };
    q('#workToggle').onclick=()=>{q('#formula').classList.toggle('show');q('#workToggle span').textContent=q('#formula').classList.contains('show')?'⌃':'⌄'};
    q('#begin').onclick=showChooser;
    q('#jumpPractice').onclick=()=>{ state.pendingPracticeIntent=true; showChooser(); };
    document.querySelectorAll('.case-card').forEach(b=>b.onclick=()=>chooseCase(b.dataset.case));
    document.querySelectorAll('.case-quicklink').forEach(b=>b.onclick=()=>chooseCase(b.dataset.case));
    q('#changeCase').onclick=showChooser;
    document.querySelectorAll('.metric').forEach(card=>card.onclick=()=>explain(card.dataset.result));
    q('#planet').onchange=()=>{let o=q('#planet').selectedOptions[0];q('#planetText').textContent=o.text;q('#planetIcon').textContent=o.dataset.icon;q('#gravityText').textContent=`g = ${(+o.value).toFixed(2)} m s⁻²`;output()};
    document.querySelectorAll('#exploreControls input').forEach(x=>x.oninput=output);
    document.querySelectorAll('#modeToggle button').forEach(btn=>btn.onclick=()=>setMode(btn.dataset.mode));
    document.querySelectorAll('#difficultyToggle button').forEach(btn=>btn.onclick=()=>{
      document.querySelectorAll('#difficultyToggle button').forEach(b=>b.classList.toggle('active',b===btn));
      state.practiceDifficulty=btn.dataset.diff; state.practiceQueueKey=null; newProblem();
    });
    q('#newQuestionBtn').onclick=newProblem;
    q('#nextQuestionBtn').onclick=newProblem;
    q('#replayBtn').onclick=playAnimation;
    q('#checkBtn').onclick=checkAnswers;
    window.onresize=()=>draw(0);
    output();
  </script>
</body></html>
